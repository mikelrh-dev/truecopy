# SDD tooling state
.atl/

# Python environments
.venv/
.venv_local/
venv/
env/

# Python caches and build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
.coverage
htmlcov/

# Local Qdrant storage (docker compose volume / bind mount data)
qdrant_data/

# Credentials (created by web auth at runtime)
users.json
.streamlit-users.json

# Operator upload staging (UUID-renamed PDFs waiting for ingestion)
.uploads/

# Operator data (JSONL, local-only by design): query log + answer cache
logs/

# Extracted page figures (derived from the operator's PDFs, local-only by design)
data/figures/

# Third-party manual PDFs (weight + copyright: never versioned, never pushed).
# Both spellings are covered: the English path used in docs and the Spanish
# folder an owner may create locally.
documentation/*.pdf
documentacion/*.pdf

# Local MLflow tracking (future, machine-local by design)
mlruns/

# Local knowledge base (karpathy wiki + study notes stay on this machine)
wiki/
raw/
outputs/
plant-rag-*.md
MEJORAS-RAG.md
scripts/wiki/

# TeachMe learning artifacts (local-only study notes, like the wiki above)
LEARNING_LOG.md
visuals/

# Local lockfile (project pins live in requirements.txt)
uv.lock
